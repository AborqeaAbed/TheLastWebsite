# ── Domains ──────────────────────────────────────────────
APP_DOMAIN=yourdomain.com
APP_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com
N8N_DOMAIN=n8n.yourdomain.com

# ── Database ──────────────────────────────────────────────
DB_NAME=thelastwebsite
DB_USERNAME=postgres
DB_PASSWORD=change_me_use_a_strong_password

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=hello@yourdomain.com

# ── Stripe ────────────────────────────────────────────────
# Use sk_test_... / pk_test_... for local/staging, sk_live_... / pk_live_... for production
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
# Get this from: stripe listen --print-secret (local) or Stripe Dashboard → Webhooks (prod)
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Admin ─────────────────────────────────────────────────
ADMIN_TOKEN=change_me_use_a_strong_random_token

# ── n8n ───────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=change_me_use_a_strong_password
